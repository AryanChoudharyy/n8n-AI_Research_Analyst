      "parameters": {
        "jsCode": "const riskText = $json.output || \"\";\n\nlet recommendation = \"WATCHLIST\";\n\n// Match \"Risk Score:\" followed by anything and then a number\nconst scoreMatch = riskText.match(/Risk Score[\\s\\S]*?(\\d{1,3})/i);\n\nlet riskScore = 50;\n\nif (scoreMatch) {\n  riskScore = parseInt(scoreMatch[1], 10);\n}\n\nif (riskScore <= 35) {\n  recommendation = \"BUY\";\n} else if (riskScore <= 60) {\n  recommendation = \"WATCHLIST\";\n} else {\n  recommendation = \"AVOID\";\n}\n\nreturn [{\n  recommendation,\n  riskScore,\n  riskAnalysis: riskText\n}];"
      },
      "type": "n8n-nodes-base.code",
