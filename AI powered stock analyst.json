    {
      "parameters": {
        "jsCode": "const recommendation = $json.recommendation || \"N/A\";\nconst riskScore = $json.risk_score || \"N/A\";\nconst generatedAt = $json.generated_at || \"\";\nlet report = $json.report || \"\";\n\n// Convert markdown headings\nreport = report.replace(/^### (.*$)/gm, '<h2>$1</h2>');\nreport = report.replace(/^## (.*$)/gm, '<h2>$1</h2>');\nreport = report.replace(/^# (.*$)/gm, '<h1>$1</h1>');\n\n// Convert bold text\nreport = report.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\n\n// Convert horizontal rules\nreport = report.replace(/^---$/gm, '<hr>');\n\n// Convert bullet points\nreport = report.replace(/^- (.*)$/gm, '<li>$1</li>');\n\n// Wrap consecutive li tags\nreport = report.replace(/(<li>.*<\\/li>)/gs, '<ul>$1</ul>');\n\n// Convert line breaks\nreport = report.replace(/\\n/g, '<br>');\n\nconst html = `\n<html>\n<body style=\"font-family: Arial, sans-serif; max-width: 900px; margin:auto; padding:20px;\">\n\n<div style=\"background:#1e293b;color:white;padding:20px;border-radius:10px;\">\n<h1>AI Stock Research Report</h1>\n<p><strong>Recommendation:</strong> ${recommendation}</p>\n<p><strong>Risk Score:</strong> ${riskScore}</p>\n<p><strong>Generated:</strong> ${generatedAt}</p>\n</div>\n\n<div style=\"padding:20px;background:#ffffff;border:1px solid #ddd;margin-top:20px;border-radius:10px;\">\n${report}\n</div>\n\n<div style=\"margin-top:20px;color:gray;font-size:12px;\">\nGenerated automatically using n8n Stock Research Analyst\n</div>\n\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    html,\n    recommendation,\n    risk_score: riskScore,\n    generated_at: generatedAt\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
